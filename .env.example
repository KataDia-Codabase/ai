# Google Cloud Settings
GOOGLE_APPLICATION_CREDENTIALS=/app/google-credentials.json
GOOGLE_CLOUD_PROJECT=your-project-id

# Database Settings (local Docker deployment)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=katadia
MYSQL_PASSWORD=katadia_password
MYSQL_DATABASE=katadia_ml
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_URI=mysql+pymysql://katadia:katadia_password@mysql:3306/katadia_ml
REDIS_URL=redis://redis:6379/0

# OpenAI Settings (for feedback generation)
OPENAI_API_KEY=your-openai-api-key

# Model Settings
WAV2VEC_MODEL_PATH=./models/wav2vec2-indonesian
WAV2VEC_ENGLISH_MODEL_PATH=./models/wav2vec2-english
MFA_MODEL_PATH=./models/mfa
WHISPER_MODEL_SIZE=base

# API Settings
API_V1_STR=/api/v1
DEBUG=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

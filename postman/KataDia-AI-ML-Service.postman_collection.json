              "raw": "{\n  \"name\": \"Scoring Model Test\",\n  \"description\": \"Test new scoring algorithm\",\n  \"experiment_type\": \"scoring_model\",\n  \"hypothesis\": \"New model improves accuracy\",\n  \"variants\": [\n    {\n      \"name\": \"Control\",\n      \"description\": \"Current model\",\n      \"config\": {\"model\": \"current\"},\n      \"weight\": 0.5\n    },\n    {\n      \"name\": \"Treatment\",\n      \"description\": \"New model\",\n      \"config\": {\"model\": \"experimental\"},\n      \"weight\": 0.5\n    }\n  ],\n  \"target_sample_size\": 100,\n  \"duration_days\": 7\n}"
            },
